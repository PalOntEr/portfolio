---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Redirecting to Dossier | PalOntEr">
    <meta http-equiv="refresh" content="0;url=/portfolio/dossier" slot="head" />
    <section class="max-w-4xl mx-auto px-6 py-32 text-center">
        <h1 class="font-serif text-3xl text-[#F5F2EB] mb-4">Relocating to Technical Dossier...</h1>
        <p class="text-sm text-[#A8A29E] font-mono mb-6">
            Technical proficiencies, competencies, and system specifications have been structured into the Technical Dossier.
        </p>
        <a href="/portfolio/dossier" class="font-mono text-xs text-[#D97706] hover:underline uppercase tracking-wider">
            Click here if not redirected automatically →
        </a>
    </section>
</Layout>
