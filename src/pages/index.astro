---
import ProjectCard from "../components/ProjectCard.astro";
import Layout from "../layouts/Layout.astro";
import SchematicWireframe from "../components/SchematicWireframe.tsx";
import { ArrowRight } from "lucide-astro";
import { projectsData } from "../data/projects";

const featuredProjects = projectsData.filter((p) =>
	["photohub", "antdefender", "derby-drift", "csi"].includes(p.id)
);
---

<Layout title="PalOntEr // Systems, Graphics & Full-Stack Engineering">
	<!-- Editorial Frontispiece / Hero Section -->
	<section class="max-w-6xl mx-auto px-6 pt-12 pb-20 md:pt-20 md:pb-28 border-b border-[#2E2B28]">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
			<!-- Left Column: Frontispiece Statement -->
			<div class="lg:col-span-7 space-y-6 animate-reveal">
				<div class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-[#D97706]">
					<span class="w-2 h-2 rounded-full bg-[#D97706]"></span>
					<span>PALONTER // MONOGRAPH 2026</span>
				</div>

				<h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-normal tracking-tight text-[#F5F2EB] leading-[1.12]">
					Engineering at the intersection of <em class="italic font-serif text-[#D97706]">GPU compute</em>, low-level graphics, and resilient web platforms.
				</h1>

				<p class="text-base sm:text-lg text-[#A8A29E] leading-relaxed font-sans max-w-xl">
					Independent software development authored by <strong class="text-[#F5F2EB] font-medium">Max Zertuche</strong>. Building hardware-accelerated image engines, raw DirectX 11 renderers, and modern distributed systems with deep technical intentionality.
				</p>

				<div class="flex flex-wrap items-center gap-4 pt-4 font-mono text-xs uppercase tracking-wider">
					<a
						href="/portfolio/projects"
						class="px-5 py-3 rounded bg-[#F5F2EB] text-[#141312] font-semibold hover:bg-[#D97706] hover:text-[#141312] transition-colors flex items-center gap-2"
					>
						<span>Explore Works</span>
						<ArrowRight class="w-3.5 h-3.5" />
					</a>
					<a
						href="/portfolio/dossier"
						class="px-5 py-3 rounded border border-[#3A3632] hover:border-[#D97706] text-[#F5F2EB] hover:text-[#D97706] transition-colors bg-[#1A1918]"
					>
						Read Dossier
					</a>
				</div>
			</div>

			<!-- Right Column: Interactive Engineering Schematic -->
			<div class="lg:col-span-5 flex justify-center lg:justify-end animate-reveal" style="animation-delay: 0.2s">
				<SchematicWireframe client:load />
			</div>
		</div>
	</section>

	<!-- Section I: Selected Works Ledger -->
	<section id="works" class="max-w-6xl mx-auto px-6 py-20 border-b border-[#2E2B28]">
		<div class="flex flex-col md:flex-row justify-between md:items-end gap-6 mb-12">
			<div>
				<div class="font-mono text-xs uppercase tracking-widest text-[#D97706] mb-2">
					INDEX // 01
				</div>
				<h2 class="font-serif text-3xl md:text-4xl font-normal text-[#F5F2EB]">
					Selected Works
				</h2>
				<p class="text-sm text-[#A8A29E] mt-2 max-w-md font-sans">
					Representative engineering monographs across GPU kernels, 3D graphics, and distributed web platforms.
				</p>
			</div>

			<a
				href="/portfolio/projects"
				class="font-mono text-xs uppercase tracking-wider text-[#D97706] hover:text-[#F5F2EB] transition-colors flex items-center gap-1.5 self-start md:self-end"
			>
				<span>View Full Catalog ({projectsData.length})</span>
				<ArrowRight class="w-3.5 h-3.5" />
			</a>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
			{featuredProjects.map((project) => (
				<ProjectCard
					index={project.index}
					name={project.name}
					domain={project.domain}
					year={project.year}
					imgsrc={project.imgsrc}
					description={project.description}
					link={project.link}
					stack={project.stack}
				/>
			))}
		</div>
	</section>

	<!-- Section II: Domains of Practice -->
	<section class="max-w-6xl mx-auto px-6 py-20">
		<div class="flex flex-col md:flex-row justify-between md:items-end gap-6 mb-12">
			<div>
				<div class="font-mono text-xs uppercase tracking-widest text-[#D97706] mb-2">
					INDEX // 02
				</div>
				<h2 class="font-serif text-3xl md:text-4xl font-normal text-[#F5F2EB]">
					Domains of Practice
				</h2>
				<p class="text-sm text-[#A8A29E] mt-2 max-w-md font-sans">
					Core engineering pillars structured by technical depth and operational domain.
				</p>
			</div>

			<a
				href="/portfolio/dossier"
				class="font-mono text-xs uppercase tracking-wider text-[#D97706] hover:text-[#F5F2EB] transition-colors flex items-center gap-1.5 self-start md:self-end"
			>
				<span>Open Complete Dossier</span>
				<ArrowRight class="w-3.5 h-3.5" />
			</a>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
			<!-- Domain 1 -->
			<div class="p-6 rounded border border-[#2E2B28] bg-[#1A1918] flex flex-col justify-between">
				<div class="space-y-4">
					<div class="font-mono text-xs text-[#D97706] uppercase tracking-wider">DOMAIN 01</div>
					<h3 class="font-serif text-2xl font-normal text-[#F5F2EB]">GPU & Systems</h3>
					<p class="text-sm text-[#A8A29E] leading-relaxed font-sans">
						Hardware-level compute optimization, GPU thread scheduling, and custom graphics rendering pipelines.
					</p>
				</div>
				<div class="mt-8 pt-4 border-t border-[#2E2B28]/60 flex flex-wrap gap-1.5 font-mono text-[10px] text-[#A8A29E]">
					<span class="px-2 py-0.5 border border-[#2E2B28] rounded bg-[#141312]">CUDA</span>
					<span class="px-2 py-0.5 border border-[#2E2B28] rounded bg-[#141312]">C++</span>
					<span class="px-2 py-0.5 border border-[#2E2B28] rounded bg-[#141312]">DirectX 11</span>
					<span class="px-2 py-0.5 border border-[#2E2B28] rounded bg-[#141312]">HLSL</span>
				</div>
			</div>

			<!-- Domain 2 -->
			<div class="p-6 rounded border border-[#2E2B28] bg-[#1A1918] flex flex-col justify-between">
				<div class="space-y-4">
					<div class="font-mono text-xs text-[#D97706] uppercase tracking-wider">DOMAIN 02</div>
					<h3 class="font-serif text-2xl font-normal text-[#F5F2EB]">Cloud & Distributed</h3>
					<p class="text-sm text-[#A8A29E] leading-relaxed font-sans">
						Server-authoritative network topologies, containerized microservices, and high-performance database schema architectures.
					</p>
				</div>
				<div class="mt-8 pt-4 border-t border-[#2E2B28]/60 flex flex-wrap gap-1.5 font-mono text-[10px] text-[#A8A29E]">
					<span class="px-2 py-0.5 border border-[#2E2B28] rounded bg-[#141312]">Node.js</span>
					<span class="px-2 py-0.5 border border-[#2E2B28] rounded bg-[#141312]">FastAPI</span>
					<span class="px-2 py-0.5 border border-[#2E2B28] rounded bg-[#141312]">Cloud Run</span>
					<span class="px-2 py-0.5 border border-[#2E2B28] rounded bg-[#141312]">SQL / MongoDB</span>
				</div>
			</div>

			<!-- Domain 3 -->
			<div class="p-6 rounded border border-[#2E2B28] bg-[#1A1918] flex flex-col justify-between">
				<div class="space-y-4">
					<div class="font-mono text-xs text-[#D97706] uppercase tracking-wider">DOMAIN 03</div>
					<h3 class="font-serif text-2xl font-normal text-[#F5F2EB]">Interface & WebGL</h3>
					<p class="text-sm text-[#A8A29E] leading-relaxed font-sans">
						Static-first web architectures, sub-millisecond perceived latency, and interactive in-browser 3D canvas systems.
					</p>
				</div>
				<div class="mt-8 pt-4 border-t border-[#2E2B28]/60 flex flex-wrap gap-1.5 font-mono text-[10px] text-[#A8A29E]">
					<span class="px-2 py-0.5 border border-[#2E2B28] rounded bg-[#141312]">Astro</span>
					<span class="px-2 py-0.5 border border-[#2E2B28] rounded bg-[#141312]">TypeScript</span>
					<span class="px-2 py-0.5 border border-[#2E2B28] rounded bg-[#141312]">Three.js</span>
					<span class="px-2 py-0.5 border border-[#2E2B28] rounded bg-[#141312]">TailwindCSS</span>
				</div>
			</div>
		</div>
	</section>
</Layout>
