---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { ArrowRight, Award, CheckCircle2, ExternalLink } from "lucide-astro";
import { achievementsData as achievements } from "../data/achievements";
---

<Layout title="Dossier // PalOntEr Competencies, Accolades & Colophon">
    <section class="max-w-6xl mx-auto px-6 pt-12 pb-24 md:pt-20">
        <!-- Dossier Header -->
        <header class="mb-14 pb-8 border-b border-[#2E2B28] animate-reveal">
            <div class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-[#D97706] mb-3">
                <span class="w-2 h-2 rounded-full bg-[#D97706]"></span>
                <span>DOSSIER // ARCHIVAL RECORD</span>
            </div>
            <h1 class="font-serif text-4xl sm:text-6xl font-normal text-[#F5F2EB] tracking-tight mb-4">
                Technical Dossier
            </h1>
            <p class="text-base sm:text-lg text-[#A8A29E] max-w-2xl font-sans leading-relaxed">
                A formal record of engineering domains, competitive hackathon accolades, and architectural colophon for <strong class="text-[#F5F2EB] font-medium">PalOntEr (Max Zertuche)</strong>.
            </p>
        </header>

        <!-- Section 1: Honors & Accolades -->
        <div class="mb-20">
            <div class="flex items-center justify-between pb-4 mb-8 border-b border-[#2E2B28]">
                <div class="flex items-center gap-3">
                    <span class="font-mono text-xs text-[#D97706]">PART I.</span>
                    <h2 class="font-serif text-2xl md:text-3xl font-normal text-[#F5F2EB]">
                        Honors & Selected Accolades
                    </h2>
                </div>
                <span class="font-mono text-xs text-[#A8A29E]">GLOBAL COMPETITIONS</span>
            </div>

            <div class="space-y-6">
                {achievements.map((item, idx) => (
                    <article class="p-6 md:p-8 rounded border border-[#2E2B28] bg-[#1A1918] hover:border-[#3A3632] transition-colors">
                        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                            <!-- Accolade Image / Certificate Plate -->
                            <div class="lg:col-span-4">
                                <div class="relative aspect-[16/10] rounded overflow-hidden border border-[#2E2B28] bg-[#11100F]">
                                    <Image
                                        loading="lazy"
                                        src={item.imgsrc as any}
                                        alt={item.name}
                                        width={500}
                                        height={312}
                                        class="w-full h-full object-cover"
                                    />
                                </div>
                                <div class="font-mono text-[10px] text-[#635F5B] mt-2 flex justify-between uppercase">
                                    <span>RECORD [0{idx + 1}]</span>
                                    <span>VERIFIED SUBMISSION</span>
                                </div>
                            </div>

                            <!-- Narrative & Result -->
                            <div class="lg:col-span-8 flex flex-col justify-between h-full space-y-4">
                                <div>
                                    <div class="flex flex-wrap items-center gap-2.5 mb-2">
                                        <span class="inline-flex items-center gap-1 font-mono text-[10px] uppercase tracking-wider px-2 py-0.5 rounded border border-[#D97706]/40 text-[#D97706] bg-[#D97706]/10">
                                            <Award class="w-3 h-3" />
                                            {item.types[0]}
                                        </span>
                                    </div>
                                    <h3 class="font-serif text-2xl font-medium text-[#F5F2EB] mb-3">
                                        {item.name}
                                    </h3>
                                    <p class="text-sm text-[#A8A29E] font-sans leading-relaxed">
                                        {item.description}
                                    </p>
                                </div>

                                <div class="pt-4 border-t border-[#2E2B28]/60 flex flex-wrap items-center justify-between gap-4">
                                    <div class="flex flex-wrap gap-1.5 font-mono text-[10px] text-[#A8A29E]">
                                        {item.stack.map((tech) => (
                                            <span class="px-2 py-0.5 border border-[#2E2B28] rounded bg-[#141312]">
                                                {tech}
                                            </span>
                                        ))}
                                    </div>

                                    {item.link && (
                                        <a
                                            href={item.link}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="font-mono text-xs text-[#D97706] hover:text-[#F5F2EB] transition-colors flex items-center gap-1"
                                        >
                                            <span>Read Citation</span>
                                            <ExternalLink class="w-3.5 h-3.5" />
                                        </a>
                                    )}
                                </div>
                            </div>
                        </div>
                    </article>
                ))}
            </div>
        </div>

        <!-- Section 2: Domains of Technical Competency -->
        <div class="mb-20">
            <div class="flex items-center justify-between pb-4 mb-8 border-b border-[#2E2B28]">
                <div class="flex items-center gap-3">
                    <span class="font-mono text-xs text-[#D97706]">PART II.</span>
                    <h2 class="font-serif text-2xl md:text-3xl font-normal text-[#F5F2EB]">
                        Domains of Competency
                    </h2>
                </div>
                <span class="font-mono text-xs text-[#A8A29E]">TECHNICAL SPECIALIZATION</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Competency 1 -->
                <div class="p-6 md:p-8 rounded border border-[#2E2B28] bg-[#1A1918] space-y-4">
                    <div class="font-mono text-xs text-[#D97706] uppercase tracking-wider">SPECIALIZATION 01</div>
                    <h3 class="font-serif text-2xl font-normal text-[#F5F2EB]">
                        GPU Compute & Graphics Pipelines
                    </h3>
                    <p class="text-sm text-[#A8A29E] font-sans leading-relaxed">
                        Deep experience with low-level execution models, SIMD parallelism, custom shader programming, and draw-call optimization without heavy black-box engines.
                    </p>
                    <ul class="font-mono text-xs text-[#A8A29E] space-y-2 pt-2 border-t border-[#2E2B28]/60">
                        <li class="flex items-center gap-2">
                            <span class="text-[#D97706]">▪</span> NVIDIA CUDA (Thread Block Scheduling, Shared Memory)
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="text-[#D97706]">▪</span> C++ (Modern C++17/20, RAII, Memory Locality)
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="text-[#D97706]">▪</span> DirectX 11 & HLSL (Vertex / Pixel Shader Pipelines)
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="text-[#D97706]">▪</span> Three.js & WebGL (In-Browser Real-Time Canvas)
                        </li>
                    </ul>
                </div>

                <!-- Competency 2 -->
                <div class="p-6 md:p-8 rounded border border-[#2E2B28] bg-[#1A1918] space-y-4">
                    <div class="font-mono text-xs text-[#D97706] uppercase tracking-wider">SPECIALIZATION 02</div>
                    <h3 class="font-serif text-2xl font-normal text-[#F5F2EB]">
                        Distributed Systems & Backends
                    </h3>
                    <p class="text-sm text-[#A8A29E] font-sans leading-relaxed">
                        Architecting resilient service layers, real-time bidirectional state replication, and containerized deployment infrastructure.
                    </p>
                    <ul class="font-mono text-xs text-[#A8A29E] space-y-2 pt-2 border-t border-[#2E2B28]/60">
                        <li class="flex items-center gap-2">
                            <span class="text-[#D97706]">▪</span> Node.js & Express (Asynchronous Event Loop, WebSockets)
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="text-[#D97706]">▪</span> Python (FastAPI, Flask, Scientific Computing)
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="text-[#D97706]">▪</span> C# & ASP.NET Core (SignalR Real-Time Hubs)
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="text-[#D97706]">▪</span> Google Cloud Run, Firebase, Docker, Linux CLI
                        </li>
                    </ul>
                </div>

                <!-- Competency 3 -->
                <div class="p-6 md:p-8 rounded border border-[#2E2B28] bg-[#1A1918] space-y-4">
                    <div class="font-mono text-xs text-[#D97706] uppercase tracking-wider">SPECIALIZATION 03</div>
                    <h3 class="font-serif text-2xl font-normal text-[#F5F2EB]">
                        Data Architecture & Persistence
                    </h3>
                    <p class="text-sm text-[#A8A29E] font-sans leading-relaxed">
                        Designing reliable relational schemas, index optimization, unstructured document stores, and vector data exploration.
                    </p>
                    <ul class="font-mono text-xs text-[#A8A29E] space-y-2 pt-2 border-t border-[#2E2B28]/60">
                        <li class="flex items-center gap-2">
                            <span class="text-[#D97706]">▪</span> Microsoft SQL Server & T-SQL Query Optimization
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="text-[#D97706]">▪</span> MongoDB Aggregation Pipelines & Document Modeling
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="text-[#D97706]">▪</span> Pandas & NumPy Data Processing Workflows
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="text-[#D97706]">▪</span> SciKit-Learn ML Feature Extraction
                        </li>
                    </ul>
                </div>

                <!-- Competency 4 -->
                <div class="p-6 md:p-8 rounded border border-[#2E2B28] bg-[#1A1918] space-y-4">
                    <div class="font-mono text-xs text-[#D97706] uppercase tracking-wider">SPECIALIZATION 04</div>
                    <h3 class="font-serif text-2xl font-normal text-[#F5F2EB]">
                        Interface Craft & Static Web
                    </h3>
                    <p class="text-sm text-[#A8A29E] font-sans leading-relaxed">
                        Performance-obsessed frontend development prioritizing Core Web Vitals, typographic rhythm, and tactile user feedback.
                    </p>
                    <ul class="font-mono text-xs text-[#A8A29E] space-y-2 pt-2 border-t border-[#2E2B28]/60">
                        <li class="flex items-center gap-2">
                            <span class="text-[#D97706]">▪</span> Astro (Static Site Generation, Islands Architecture)
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="text-[#D97706]">▪</span> TypeScript (Strict Type Safety & Schema Invariants)
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="text-[#D97706]">▪</span> React 19 & Component Lifecycle Optimization
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="text-[#D97706]">▪</span> Tailwind CSS v4 & Precision Token Systems
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Section 3: Archival Colophon -->
        <div class="p-8 md:p-10 rounded border border-[#2E2B28] bg-[#161514]">
            <div class="flex items-center gap-3 mb-6">
                <span class="font-mono text-xs text-[#D97706]">PART III.</span>
                <h2 class="font-serif text-2xl font-normal text-[#F5F2EB]">
                    Site Colophon
                </h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 font-mono text-xs text-[#A8A29E]">
                <div class="space-y-2">
                    <div class="text-[#F5F2EB] uppercase tracking-wider text-[11px]">Typography</div>
                    <p class="font-sans leading-relaxed text-sm">
                        Typeset in <strong class="text-[#F5F2EB]">Newsreader</strong> (Display Serif designed by Production Type) and <strong class="text-[#F5F2EB]">Geist</strong> / <strong class="text-[#F5F2EB]">Geist Mono</strong>.
                    </p>
                </div>

                <div class="space-y-2">
                    <div class="text-[#F5F2EB] uppercase tracking-wider text-[11px]">Architecture</div>
                    <p class="font-sans leading-relaxed text-sm">
                        Built with <strong class="text-[#F5F2EB]">Astro SSG</strong>, compiled with Vite, and styled with zero-runtime utility tokens via Tailwind CSS v4.
                    </p>
                </div>

                <div class="space-y-2">
                    <div class="text-[#F5F2EB] uppercase tracking-wider text-[11px]">Philosophy</div>
                    <p class="font-sans leading-relaxed text-sm">
                        Zero bloated 3D canvases, zero corporate template filler. Dedicated to speed, typographic authority, and technical depth.
                    </p>
                </div>
            </div>
        </div>
    </section>
</Layout>
