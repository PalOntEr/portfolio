---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { ArrowRight, ChevronDown, ExternalLink } from "lucide-astro";
import { projectsData as projects } from "../data/projects";

const domains = ["All", "GPU & Systems", "Graphics & Games", "Web & Cloud", "Tools & Data"];
---

<Layout title="Works // PalOntEr Engineering Monographs">
    <section class="max-w-6xl mx-auto px-6 pt-12 pb-24 md:pt-20">
        <!-- Monograph Header -->
        <header class="mb-14 pb-8 border-b border-[#2E2B28] animate-reveal">
            <div class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-[#D97706] mb-3">
                <span class="w-2 h-2 rounded-full bg-[#D97706]"></span>
                <span>VOL. 26 // ENGINEERING MONOGRAPHS</span>
            </div>
            <h1 class="font-serif text-4xl sm:text-6xl font-normal text-[#F5F2EB] tracking-tight mb-4">
                Selected Works
            </h1>
            <p class="text-base sm:text-lg text-[#A8A29E] max-w-2xl font-sans leading-relaxed">
                An annotated catalog of graphics engines, GPU compute kernels, and distributed web platforms authored by <strong class="text-[#F5F2EB] font-medium">PalOntEr (Max Zertuche)</strong>. Expand any plate to inspect the underlying architectural trade-offs.
            </p>

            <!-- Domain Filter Chips -->
            <div class="flex flex-wrap items-center gap-2 pt-6 font-mono text-xs">
                {domains.map((domain) => (
                    <button
                        data-filter={domain}
                        class={`filter-btn px-3.5 py-1.5 rounded border transition-colors cursor-pointer ${
                            domain === "All"
                                ? "bg-[#F5F2EB] text-[#141312] border-[#F5F2EB] font-semibold active-filter"
                                : "bg-[#1A1918] text-[#A8A29E] border-[#2E2B28] hover:text-[#F5F2EB] hover:border-[#3A3632]"
                        }`}
                    >
                        {domain}
                    </button>
                ))}
            </div>
        </header>

        <!-- Monograph Works Ledger -->
        <div class="space-y-6" id="monograph-ledger">
            {projects.map((project) => (
                <article
                    data-domain={project.domain}
                    class="project-entry rounded border border-[#2E2B28] bg-[#1A1918] transition-all hover:border-[#3A3632] overflow-hidden"
                >
                    <!-- Summary Row / Interactive Header -->
                    <details class="group/case cursor-pointer">
                        <summary class="list-none p-6 md:p-8 flex flex-col md:flex-row md:items-center justify-between gap-6 select-none focus:outline-none focus:ring-1 focus:ring-[#D97706]/50">
                            <div class="flex items-start md:items-center gap-6">
                                <span class="font-mono text-xs text-[#D97706] font-semibold shrink-0 pt-1 md:pt-0">
                                    {project.index}.
                                </span>
                                <div>
                                    <div class="flex flex-wrap items-center gap-3 mb-1.5">
                                        <h2 class="font-serif text-2xl md:text-3xl font-medium text-[#F5F2EB] group-hover/case:text-[#D97706] transition-colors">
                                            {project.name}
                                        </h2>
                                        <span class="font-mono text-[10px] text-[#A8A29E] uppercase tracking-wider px-2 py-0.5 rounded border border-[#2E2B28] bg-[#141312]">
                                            {project.domain}
                                        </span>
                                    </div>
                                    <p class="text-sm text-[#A8A29E] max-w-xl font-sans line-clamp-2 leading-relaxed">
                                        {project.description}
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-center justify-between md:justify-end gap-6 shrink-0 pt-4 md:pt-0 border-t md:border-t-0 border-[#2E2B28]/60">
                                <div class="hidden lg:flex flex-wrap gap-1.5 font-mono text-[10px] text-[#A8A29E] max-w-xs justify-end">
                                    {project.stack.slice(0, 3).map((tech) => (
                                        <span class="px-2 py-0.5 border border-[#2E2B28] rounded bg-[#141312]">
                                            {tech}
                                        </span>
                                    ))}
                                </div>

                                <div class="flex items-center gap-2 font-mono text-xs text-[#D97706] group-hover/case:text-[#F5F2EB] transition-colors">
                                    <span class="group-open/case:hidden">Inspect Study</span>
                                    <span class="hidden group-open/case:inline">Collapse</span>
                                    <ChevronDown class="w-4 h-4 transition-transform duration-200 group-open/case:rotate-180" />
                                </div>
                            </div>
                        </summary>

                        <!-- Expanded Case Study Plate -->
                        <div class="px-6 pb-8 md:px-8 md:pb-10 pt-2 border-t border-[#2E2B28]/60 bg-[#161514] cursor-default">
                            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 pt-6">
                                <!-- Architectural Figures / Media -->
                                <div class="lg:col-span-6 space-y-3">
                                    <div class="relative aspect-[16/10] overflow-hidden rounded border border-[#2E2B28] bg-[#11100F]">
                                        <Image
                                            loading="lazy"
                                            src={project.imgsrc as any}
                                            alt={project.name}
                                            width={700}
                                            height={438}
                                            class="w-full h-full object-cover"
                                        />
                                    </div>
                                    <div class="font-mono text-[10px] text-[#635F5B] flex justify-between tracking-wider uppercase px-1">
                                        <span>FIG. {project.index}.1 // {project.name} DEPLOYMENT</span>
                                        <span>YEAR: {project.year}</span>
                                    </div>
                                </div>

                                <!-- Technical Study Text -->
                                <div class="lg:col-span-6 flex flex-col justify-between space-y-6">
                                    <div class="space-y-4">
                                        <div>
                                            <h4 class="font-mono text-xs uppercase tracking-wider text-[#D97706] mb-1">
                                                01. Engineering Constraint
                                            </h4>
                                            <p class="text-sm text-[#A8A29E] font-sans leading-relaxed">
                                                {project.technicalDetails.problem}
                                            </p>
                                        </div>

                                        <div>
                                            <h4 class="font-mono text-xs uppercase tracking-wider text-[#D97706] mb-1">
                                                02. Architecture & Implementation
                                            </h4>
                                            <p class="text-sm text-[#A8A29E] font-sans leading-relaxed">
                                                {project.technicalDetails.architecture}
                                            </p>
                                        </div>

                                        <div>
                                            <h4 class="font-mono text-xs uppercase tracking-wider text-[#10B981] mb-1">
                                                03. Observed Outcome
                                            </h4>
                                            <p class="text-sm text-[#F5F2EB] font-sans leading-relaxed">
                                                {project.technicalDetails.highlight}
                                            </p>
                                        </div>
                                    </div>

                                    <!-- Bottom Metadata Bar -->
                                    <div class="pt-4 border-t border-[#2E2B28] flex flex-wrap items-center justify-between gap-4">
                                        <div class="flex flex-wrap gap-1.5 font-mono text-[10px] text-[#A8A29E]">
                                            {project.stack.map((tech) => (
                                                <span class="px-2 py-0.5 border border-[#2E2B28] rounded bg-[#141312]">
                                                    {tech}
                                                </span>
                                            ))}
                                        </div>

                                        {project.link && (
                                            <a
                                                href={project.link}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="font-mono text-xs text-[#141312] bg-[#F5F2EB] hover:bg-[#D97706] px-4 py-2 rounded font-semibold transition-colors flex items-center gap-1.5"
                                            >
                                                <span>Source / Dispatch</span>
                                                <ExternalLink class="w-3.5 h-3.5" />
                                            </a>
                                        )}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </details>
                </article>
            ))}
        </div>
    </section>


    <script>
        document.addEventListener("astro:page-load", () => {
            const filterBtns = document.querySelectorAll(".filter-btn");
            const entries = document.querySelectorAll(".project-entry");

            filterBtns.forEach((btn) => {
                btn.addEventListener("click", () => {
                    const domain = btn.getAttribute("data-filter");

                    filterBtns.forEach((b) => {
                        b.classList.remove("bg-[#F5F2EB]", "text-[#141312]", "border-[#F5F2EB]", "font-semibold");
                        b.classList.add("bg-[#1A1918]", "text-[#A8A29E]", "border-[#2E2B28]");
                    });
                    btn.classList.remove("bg-[#1A1918]", "text-[#A8A29E]", "border-[#2E2B28]");
                    btn.classList.add("bg-[#F5F2EB]", "text-[#141312]", "border-[#F5F2EB]", "font-semibold");

                    entries.forEach((entry) => {
                        const entryDomain = entry.getAttribute("data-domain");
                        if (domain === "All" || entryDomain === domain) {
                            (entry as HTMLElement).style.display = "block";
                        } else {
                            (entry as HTMLElement).style.display = "none";
                        }
                    });
                });
            });
        });
    </script>
</Layout>
