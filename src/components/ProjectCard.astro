---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    index?: string;
    name: string;
    domain?: string;
    year?: string;
    imgsrc: ImageMetadata | string;
    link?: string;
    description?: string;
    stack?: string[];
}

const { index = "01", name, domain = "Systems", year = "2024", imgsrc, link, description, stack } = Astro.props;
const srcAsAny = imgsrc as any;
---

<article
    class="group relative flex flex-col rounded border border-[#2E2B28] bg-[#1A1918] hover:border-[#D97706]/60 transition-all duration-300 overflow-hidden"
>
    <!-- Plate Header Bar -->
    <div class="flex items-center justify-between px-5 py-3 border-b border-[#2E2B28] bg-[#161514] font-mono text-[11px] text-[#A8A29E]">
        <div class="flex items-center gap-2">
            <span class="text-[#D97706] font-semibold">{index}.</span>
            <span class="uppercase tracking-wider">{domain}</span>
        </div>
        <span>{year}</span>
    </div>

    <!-- Archival Image Container -->
    <div class="relative aspect-[16/10] overflow-hidden bg-[#11100F] border-b border-[#2E2B28]">
        <Image
            loading="lazy"
            src={srcAsAny}
            alt={name}
            width={600}
            height={375}
            class="w-full h-full object-cover grayscale-[25%] group-hover:grayscale-0 group-hover:scale-105 transition-all duration-500 opacity-80 group-hover:opacity-100"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#141312] via-transparent to-transparent opacity-60"></div>
    </div>

    <!-- Content Body -->
    <div class="p-6 flex flex-col flex-1 justify-between gap-4">
        <div>
            <h3 class="font-serif text-xl md:text-2xl font-medium text-[#F5F2EB] group-hover:text-[#D97706] transition-colors mb-2">
                {name}
            </h3>
            {description && (
                <p class="text-sm text-[#A8A29E] leading-relaxed line-clamp-3 font-sans">
                    {description}
                </p>
            )}
        </div>

        <!-- Tech Stack Tags & Link -->
        <div class="pt-4 border-t border-[#2E2B28]/60 flex items-center justify-between gap-2">
            <div class="flex flex-wrap gap-1.5 font-mono text-[10px] text-[#A8A29E]">
                {stack?.slice(0, 4).map((tech) => (
                    <span class="px-2 py-0.5 border border-[#2E2B28] rounded bg-[#141312]">
                        {tech}
                    </span>
                ))}
                {stack && stack.length > 4 && (
                    <span class="px-1.5 py-0.5 text-[#635F5B]">
                        +{stack.length - 4}
                    </span>
                )}
            </div>

            {link && (
                <a
                    href={link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-xs text-[#D97706] hover:text-[#F5F2EB] transition-colors flex items-center gap-1 shrink-0 ml-2"
                >
                    <span>View</span>
                    <span>↗</span>
                </a>
            )}
        </div>
    </div>
</article>
