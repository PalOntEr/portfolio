<header class="sticky top-0 left-0 w-full z-50 border-b border-[#2E2B28] bg-[#141312]/90 backdrop-blur-md transition-colors">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/portfolio/" class="group flex items-center gap-3">
      <span class="font-sans text-lg tracking-[0.12em] font-semibold text-[#F5F2EB] group-hover:text-[#D97706] transition-colors">
        PALONTER
      </span>
      <span class="hidden sm:inline-block font-mono text-[10px] text-[#A8A29E] tracking-wider uppercase px-2 py-0.5 border border-[#2E2B28] rounded bg-[#1A1918]">
        ENGINEERING
      </span>
    </a>

    <nav id="desktop-menu" class="hidden md:flex items-center gap-8 font-mono text-xs uppercase tracking-wider">
      <a
        href="/portfolio/projects"
        class="text-[#A8A29E] hover:text-[#F5F2EB] transition-colors flex items-center gap-1.5 py-1"
      >
        <span class="text-[#D97706]/70">01.</span> Works
      </a>
      <a
        href="/portfolio/dossier"
        class="text-[#A8A29E] hover:text-[#F5F2EB] transition-colors flex items-center gap-1.5 py-1"
      >
        <span class="text-[#D97706]/70">02.</span> Dossier
      </a>
      <a
        download="MaxZertuche_Resume.pdf"
        href="/portfolio/files/MaxZertuche_Resume.pdf"
        target="_blank"
        class="text-[#F5F2EB] border border-[#3A3632] hover:border-[#D97706] bg-[#1A1918] px-3.5 py-1.5 rounded transition-all flex items-center gap-1 hover:text-[#D97706]"
      >
        Resume <span class="text-[10px]">↗</span>
      </a>
    </nav>

    <button
      id="mobile-menu-btn"
      aria-label="Toggle Navigation Menu"
      class="md:hidden p-2 text-[#A8A29E] hover:text-[#F5F2EB] transition-colors cursor-pointer"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="4" x2="20" y1="8" y2="8"></line>
        <line x1="4" x2="20" y1="16" y2="16"></line>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden border-b border-[#2E2B28] bg-[#1A1918] px-6 py-6 md:hidden flex flex-col gap-4 font-mono text-xs uppercase tracking-wider"
  >
    <a
      href="/portfolio/projects"
      class="text-[#A8A29E] hover:text-[#F5F2EB] py-2 flex items-center gap-2 border-b border-[#2E2B28]/50"
    >
      <span class="text-[#D97706]">01.</span> Works
    </a>
    <a
      href="/portfolio/dossier"
      class="text-[#A8A29E] hover:text-[#F5F2EB] py-2 flex items-center gap-2 border-b border-[#2E2B28]/50"
    >
      <span class="text-[#D97706]">02.</span> Dossier
    </a>
    <a
      download="MaxZertuche_Resume.pdf"
      href="/portfolio/files/MaxZertuche_Resume.pdf"
      target="_blank"
      class="text-[#D97706] py-2 flex items-center justify-between"
    >
      <span>Resume (Max Zertuche)</span>
      <span>↗</span>
    </a>
  </div>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");

    if (btn && menu) {
      btn.onclick = () => {
        menu.classList.toggle("hidden");
      };
    }
  });
</script>
