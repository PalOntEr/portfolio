---
import { Github, Linkedin, ArrowUp } from "lucide-astro";
---

<footer class="w-full py-16 px-6 border-t border-[#2E2B28] bg-[#141312] mt-auto">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-start gap-12">
    <div class="space-y-4 max-w-sm">
      <div class="flex items-center gap-2">
        <span class="font-serif text-lg tracking-[0.12em] font-semibold text-[#F5F2EB]">
          PALONTER
        </span>
        <span class="font-mono text-[10px] text-[#A8A29E] tracking-wider uppercase px-2 py-0.5 border border-[#2E2B28] rounded bg-[#1A1918]">
          COLOPHON
        </span>
      </div>
      <p class="text-sm text-[#A8A29E] leading-relaxed font-sans">
        Independent engineering studio authored by <span class="text-[#F5F2EB] font-medium">Max Zertuche</span>. Exploring the boundaries between hardware-accelerated graphics, GPU kernels, and modern distributed web systems.
      </p>
      <div class="font-mono text-[11px] text-[#635F5B] space-y-1">
        <p>Typeset in Newsreader & Geist.</p>
        <p>Built with Astro SSG. Hosted on GitHub Pages.</p>
      </div>
    </div>

    <div class="flex flex-col md:items-end gap-6 w-full md:w-auto">
      <div class="flex items-center gap-6 font-mono text-xs uppercase tracking-wider">
        <a
          href="https://github.com/PalOntEr"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#A8A29E] hover:text-[#D97706] transition-colors flex items-center gap-1.5"
        >
          <Github class="w-4 h-4" />
          <span>GitHub</span>
          <span class="text-[10px]">↗</span>
        </a>
        <a
          href="https://linkedin.com/in/mazp"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#A8A29E] hover:text-[#D97706] transition-colors flex items-center gap-1.5"
        >
          <Linkedin class="w-4 h-4" />
          <span>LinkedIn</span>
          <span class="text-[10px]">↗</span>
        </a>
      </div>

      <div class="flex items-center justify-between md:justify-end gap-6 w-full pt-4 border-t border-[#2E2B28]/60 text-xs font-mono text-[#635F5B]">
        <span>&copy; {new Date().getFullYear()} PALONTER</span>
        <button
          onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
          class="text-[#A8A29E] hover:text-[#F5F2EB] transition-colors flex items-center gap-1 cursor-pointer"
        >
          <span>Back to Top</span>
          <ArrowUp class="w-3.5 h-3.5" />
        </button>
      </div>
    </div>
  </div>
</footer>
